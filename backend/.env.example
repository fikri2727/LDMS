# Same values as ldms-web/.env — the Python backend uses the same Supabase database.
# Transaction pooler (port 6543). The "?pgbouncer=true" suffix is stripped automatically.
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# At least 32 random characters. Signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where the React frontend runs in development (for CORS).
FRONTEND_ORIGIN=http://localhost:3002

# Set to true in production (HTTPS) so the cookie is Secure.
COOKIE_SECURE=false
